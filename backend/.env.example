# 阿里云百炼 API Configuration（OpenAI 兼容接口）
# API Key 获取：https://bailian.console.aliyun.com → 模型广场 → API Key
OPENAI_API_KEY=sk-xxx

# Base URL（华北2-北京地域，OpenAI 兼容模式）
# 注意：如需使用 WorkspaceId 格式，请替换为：
# https://{你的WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Model Selection（阿里云百炼千问最新模型）
# 主力模型：qwen3.8-max（旗舰级，适合复杂意图理解和服务编排）
MODEL_NAME=qwen3.8-max
# 轻量模型：qwen3.7-flash（快速响应，适合简单分类和判断）
MODEL_NAME_LITE=qwen3.7-flash

# Server Configuration
BACKEND_PORT=8000
LOG_LEVEL=INFO
