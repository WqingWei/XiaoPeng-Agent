      "estimated_duration_s": 3
    }
  ],
  "total_estimated_time_s": 3,
  "tool_selection_reasons": [{"tool": "工具名", "reason": "选择原因"}],
  "alternatives_considered": [{"option": "替代方案", "reason_rejected": "未采用原因"}],
  "requires_confirmation": false,
  "confirmation_message": ""
}
